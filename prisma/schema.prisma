// [MODEL] Schema do banco de dados
//
// O QUE FAZ: define o modelo de dados do sistema, do qual saem as migrations
// e o cliente tipado do Prisma.
//
// COMO FARÁ: cada entidade do DRS vira um model, com os relacionamentos e as
// restrições de integridade. As listas do front (produto com várias
// categorias, RN0012) viram tabelas de ligação. Os tipos de `src/types/` são
// a referência: já descrevem os campos de cada entidade.
//
// ATENDE: base de toda a persistência
//
// ESTADO: modelado o recorte do domínio de CLIENTES — Cliente, Telefone,
// Endereco, Cartao, Pet e as quatro tabelas de domínio que eles referenciam.
// O schema cresce por fatia: os grupos Produtos, Vendas, Estoque e Sistema
// entram nas migrations seguintes, sem alterar o que já está aqui.
//
// Grupos previstos, conforme a Visão de Dados do DVP:
//   Produtos  — Produto, GrupoPrecificacao, Marca, Categoria, Cor, Material,
//               Porte, Especie                                   [pendente]
//   Clientes  — Cliente, Pet, Endereco, Cartao, Telefone         [feito]
//   Vendas    — Pedido, ItemPedido, Pagamento, Cupom, Troca      [pendente]
//   Estoque   — ItemEstoque, MovimentacaoEstoque, Fornecedor     [pendente]
//   Sistema   — Usuario, LogTransacao, MotivoSituacao            [pendente]

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Conexao das consultas: passa pelo pooler do Supabase (porta 6543).
  url       = env("DATABASE_URL")
  // Conexao direta (porta 5432): o `prisma migrate` exige, porque o
  // pooler nao suporta os comandos de alteracao de esquema.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enumerações
// ---------------------------------------------------------------------------

/// RN0026: gênero é um dos dados obrigatórios do cadastro.
enum Genero {
  MASCULINO
  FEMININO
  OUTRO
}

/// RN0021/RN0022: todo endereço serve para entrega ou para cobrança.
enum TipoEndereco {
  ENTREGA
  COBRANCA
}

/// Espécie e porte do pet são listas fechadas no contrato do front, então
/// viram enum em vez de tabela de domínio (RN0029).
enum Especie {
  CAO
  GATO
  OUTRO
}

enum PorteSigla {
  PP
  P
  M
  G
  GG
}

// ---------------------------------------------------------------------------
// Tabelas de domínio (RNF0013) referenciadas por este recorte
// ---------------------------------------------------------------------------

/// RN0026: o telefone do cliente tem tipo (celular, residencial, comercial).
model TipoTelefone {
  id        Int        @id @default(autoincrement())
  nome      String     @unique
  telefones Telefone[]

  @@map("tipo_telefone")
}

/// RN0023: dado obrigatório do endereço.
model TipoResidencia {
  id        Int        @id @default(autoincrement())
  nome      String     @unique
  enderecos Endereco[]

  @@map("tipo_residencia")
}

/// RN0023: dado obrigatório do endereço.
model TipoLogradouro {
  id        Int        @id @default(autoincrement())
  nome      String     @unique
  enderecos Endereco[]

  @@map("tipo_logradouro")
}

/// RN0025: só cartões destas bandeiras podem ser cadastrados.
model BandeiraCartao {
  id      Int      @id @default(autoincrement())
  nome    String   @unique
  cartoes Cartao[]

  @@map("bandeira_cartao")
}

// ---------------------------------------------------------------------------
// Clientes
// ---------------------------------------------------------------------------

/// RF0021-RF0025. O CPF e o e-mail são únicos; o CPF é gravado só com
/// dígitos, para que duas grafias da mesma pessoa não passem pela restrição.
model Cliente {
  id                      Int      @id @default(autoincrement())
  /// RNF0035: código único no formato CLI-0000, gerado pelo sistema.
  codigo                  String   @unique
  nome                    String
  genero                  Genero
  dataNascimento          DateTime @map("data_nascimento") @db.Date
  /// Somente dígitos — a formatação é responsabilidade da camada de saída.
  cpf                     String   @unique
  email                   String   @unique
  /// RN0027: nota de 1 a 5 derivada do histórico de compras.
  ranking                 Int      @default(1)
  /// RF0023: cadastro inativado nunca é apagado.
  ativo                   Boolean  @default(true)
  justificativaInativacao String?  @map("justificativa_inativacao")
  criadoEm                DateTime @default(now()) @map("criado_em")
  atualizadoEm            DateTime @updatedAt @map("atualizado_em")

  telefone  Telefone?
  enderecos Endereco[]
  cartoes   Cartao[]
  pets      Pet[]
  cupons    Cupom[]
  carrinho  Carrinho?
  pedidos   Pedido[]

  @@index([nome])
  @@map("cliente")
}

/// RN0026: composto por tipo, DDD e número. Um por cliente — daí o `@unique`
/// em `clienteId`, que transforma a relação em 1-para-1.
model Telefone {
  id        Int    @id @default(autoincrement())
  clienteId Int    @unique @map("cliente_id")
  tipoId    Int    @map("tipo_id")
  ddd       String @db.VarChar(3)
  numero    String @db.VarChar(15)

  cliente Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tipo    TipoTelefone @relation(fields: [tipoId], references: [id])

  @@map("telefone")
}

/// RN0023: todos os campos são obrigatórios, exceto `observacoes`.
model Endereco {
  id               Int          @id @default(autoincrement())
  clienteId        Int          @map("cliente_id")
  /// RF0026: frase curta que identifica o endereço (ex.: "Casa").
  apelido          String
  tipo             TipoEndereco
  tipoResidenciaId Int          @map("tipo_residencia_id")
  tipoLogradouroId Int          @map("tipo_logradouro_id")
  logradouro       String
  numero           String
  bairro           String
  cep              String       @db.VarChar(9)
  cidade           String
  estado           String       @db.VarChar(2)
  pais             String
  observacoes      String?

  cliente        Cliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tipoResidencia TipoResidencia @relation(fields: [tipoResidenciaId], references: [id])
  tipoLogradouro TipoLogradouro @relation(fields: [tipoLogradouroId], references: [id])

  pedidos Pedido[]

  @@index([clienteId])
  @@map("endereco")
}

/// RN0024/RN0025 e RF0027 (o preferencial).
model Cartao {
  id              Int     @id @default(autoincrement())
  clienteId       Int     @map("cliente_id")
  numero          String  @db.VarChar(19)
  nomeImpresso    String  @map("nome_impresso")
  bandeiraId      Int     @map("bandeira_id")
  codigoSeguranca String  @map("codigo_seguranca") @db.VarChar(4)
  /// RF0027: exatamente um cartão do cliente é o preferencial.
  preferencial    Boolean @default(false)

  cliente  Cliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  bandeira BandeiraCartao @relation(fields: [bandeiraId], references: [id])

  pagamentos Pagamento[]

  @@index([clienteId])
  @@map("cartao")
}

/// RN0029: todo pet pertence obrigatoriamente a um cliente.
model Pet {
  id        Int        @id @default(autoincrement())
  clienteId Int        @map("cliente_id")
  nome      String
  especie   Especie
  raca      String
  porte     PorteSigla
  peso      Decimal    @db.Decimal(5, 2)

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@map("pet")
}

// ---------------------------------------------------------------------------
// Grupo Produtos — fatia necessária ao catálogo e ao carrinho
// ---------------------------------------------------------------------------

/// RN0013: a margem deste grupo define o valor de venda a partir do custo.
model GrupoPrecificacao {
  id          Int     @id @default(autoincrement())
  nome        String  @unique
  margemLucro Decimal @map("margem_lucro") @db.Decimal(6, 2)

  produtos Produto[]

  @@map("grupo_precificacao")
}

model Marca {
  id   Int    @id @default(autoincrement())
  nome String @unique

  produtos Produto[]

  @@map("marca")
}

/// RN0012: um produto pode estar associado a mais de uma categoria.
model Categoria {
  id   Int    @id @default(autoincrement())
  nome String @unique

  produtos ProdutoCategoria[]

  @@map("categoria")
}

model Cor {
  id   Int    @id @default(autoincrement())
  nome String @unique

  produtos Produto[]

  @@map("cor")
}

model Material {
  id   Int    @id @default(autoincrement())
  nome String @unique

  produtos Produto[]

  @@map("material")
}

/// Metadados do porte, usados nos filtros do catálogo. O porte do produto em
/// si é gravado no enum PorteSigla, como no cadastro de pet.
model Porte {
  id      Int        @id @default(autoincrement())
  sigla   PorteSigla @unique
  nome    String
  pesoMin Decimal    @map("peso_min") @db.Decimal(5, 2)
  pesoMax Decimal    @map("peso_max") @db.Decimal(5, 2)

  @@map("porte")
}

/// RN0050: toda entrada em estoque identifica o fornecedor.
model Fornecedor {
  id   Int    @id @default(autoincrement())
  nome String @unique
  cnpj String @unique @db.VarChar(18)

  itensEstoque ItemEstoque[]

  @@map("fornecedor")
}

/// RF0011-RF0016 e RNF0021 (SKU único). O valor de venda nasce do custo e da
/// margem do grupo de precificação (RN0013).
model Produto {
  id                  Int        @id @default(autoincrement())
  sku                 String     @unique @db.VarChar(16)
  nome                String
  descricao           String
  marcaId             Int        @map("marca_id")
  especie             Especie
  porte               PorteSigla
  corId               Int        @map("cor_id")
  materialId          Int        @map("material_id")
  altura              Decimal    @db.Decimal(6, 2)
  largura             Decimal    @db.Decimal(6, 2)
  profundidade        Decimal    @db.Decimal(6, 2)
  peso                Decimal    @db.Decimal(6, 3)
  codigoBarras        String     @unique @map("codigo_barras") @db.VarChar(20)
  grupoPrecificacaoId Int        @map("grupo_precificacao_id")
  valorCusto          Decimal    @map("valor_custo") @db.Decimal(10, 2)
  valorVenda          Decimal    @map("valor_venda") @db.Decimal(10, 2)
  ativo               Boolean    @default(true)
  imagem              String?
  totalVendido        Int        @default(0) @map("total_vendido")
  criadoEm            DateTime   @default(now()) @map("criado_em")
  atualizadoEm        DateTime   @updatedAt @map("atualizado_em")

  marca             Marca             @relation(fields: [marcaId], references: [id])
  cor               Cor               @relation(fields: [corId], references: [id])
  material          Material          @relation(fields: [materialId], references: [id])
  grupoPrecificacao GrupoPrecificacao @relation(fields: [grupoPrecificacaoId], references: [id])

  categorias    ProdutoCategoria[]
  itensEstoque  ItemEstoque[]
  itensCarrinho ItemCarrinho[]
  itensPedido   ItemPedido[]

  @@index([nome])
  @@index([ativo])
  @@map("produto")
}

/// RN0012: tabela de ligação entre o produto e suas categorias.
model ProdutoCategoria {
  produtoId   Int @map("produto_id")
  categoriaId Int @map("categoria_id")

  produto   Produto   @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  categoria Categoria @relation(fields: [categoriaId], references: [id])

  @@id([produtoId, categoriaId])
  @@map("produto_categoria")
}

// ---------------------------------------------------------------------------
// Grupo Estoque — somente a entrada, que sustenta a validação da RN0031
// ---------------------------------------------------------------------------

/// RN0050: produto, quantidade, custo, fornecedor e data são obrigatórios.
/// RN0061 e RN0062: quantidade maior que zero e custo sempre informado.
/// O saldo disponível de um produto é a soma das quantidades dos seus lotes;
/// a baixa em estoque (RF0053) está fora do escopo desta fase.
model ItemEstoque {
  id           Int      @id @default(autoincrement())
  produtoId    Int      @map("produto_id")
  quantidade   Int
  valorCusto   Decimal  @map("valor_custo") @db.Decimal(10, 2)
  fornecedorId Int      @map("fornecedor_id")
  dataEntrada  DateTime @map("data_entrada") @db.Date

  produto    Produto    @relation(fields: [produtoId], references: [id])
  fornecedor Fornecedor @relation(fields: [fornecedorId], references: [id])

  @@index([produtoId])
  @@map("item_estoque")
}

// ---------------------------------------------------------------------------
// Grupo Vendas — carrinho, cupom e pedido
// ---------------------------------------------------------------------------

enum TipoCupom {
  TROCA
  PROMOCIONAL
}

enum SituacaoPedido {
  EM_PROCESSAMENTO
  APROVADA
  REPROVADA
  EM_TRANSPORTE
  ENTREGUE
  EM_TROCA
  TROCA_AUTORIZADA
  TROCADO
}

enum FormaPagamento {
  CARTAO
  CUPOM_TROCA
  CUPOM_PROMOCIONAL
}

/// RF0037. O cupom promocional é geral, sem dono; o de troca pertence ao
/// cliente que o recebeu (RN0036).
model Cupom {
  id        Int       @id @default(autoincrement())
  codigo    String    @unique @db.VarChar(24)
  tipo      TipoCupom
  valor     Decimal   @db.Decimal(10, 2)
  validade  DateTime  @db.Date
  utilizado Boolean   @default(false)
  clienteId Int?      @map("cliente_id")
  criadoEm  DateTime  @default(now()) @map("criado_em")

  cliente    Cliente?    @relation(fields: [clienteId], references: [id])
  pagamentos Pagamento[]

  @@index([clienteId])
  @@map("cupom")
}

/// RF0031: repositório temporário de itens, um por cliente.
model Carrinho {
  id           Int      @id @default(autoincrement())
  clienteId    Int      @unique @map("cliente_id")
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  cliente Cliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  itens   ItemCarrinho[]

  @@map("carrinho")
}

/// RF0032: a quantidade é editável na adição e na visualização do carrinho.
model ItemCarrinho {
  id            Int     @id @default(autoincrement())
  carrinhoId    Int     @map("carrinho_id")
  produtoId     Int     @map("produto_id")
  quantidade    Int
  valorUnitario Decimal @map("valor_unitario") @db.Decimal(10, 2)

  carrinho Carrinho @relation(fields: [carrinhoId], references: [id], onDelete: Cascade)
  produto  Produto  @relation(fields: [produtoId], references: [id])

  @@unique([carrinhoId, produtoId])
  @@index([carrinhoId])
  @@map("item_carrinho")
}

/// RF0033 e RF0038: a compra nasce com a situação EM_PROCESSAMENTO.
model Pedido {
  id                Int            @id @default(autoincrement())
  numero            String         @unique @db.VarChar(16)
  clienteId         Int            @map("cliente_id")
  enderecoEntregaId Int            @map("endereco_entrega_id")
  frete             Decimal        @db.Decimal(10, 2)
  subtotal          Decimal        @db.Decimal(10, 2)
  total             Decimal        @db.Decimal(10, 2)
  situacao          SituacaoPedido @default(EM_PROCESSAMENTO)
  dataCompra        DateTime       @default(now()) @map("data_compra")
  /// RN0036: código do cupom gerado com a sobra dos cupons utilizados.
  cupomTrocoCodigo  String?        @map("cupom_troco_codigo") @db.VarChar(24)

  cliente         Cliente  @relation(fields: [clienteId], references: [id])
  enderecoEntrega Endereco @relation(fields: [enderecoEntregaId], references: [id])

  itens      ItemPedido[]
  pagamentos Pagamento[]

  @@index([clienteId])
  @@index([situacao])
  @@map("pedido")
}

/// Os dados do produto são copiados no momento da compra, para que alterações
/// posteriores no catálogo não reescrevam o histórico do pedido.
model ItemPedido {
  id            Int     @id @default(autoincrement())
  pedidoId      Int     @map("pedido_id")
  produtoId     Int     @map("produto_id")
  produtoNome   String  @map("produto_nome")
  produtoSku    String  @map("produto_sku") @db.VarChar(16)
  quantidade    Int
  valorUnitario Decimal @map("valor_unitario") @db.Decimal(10, 2)
  subtotal      Decimal @db.Decimal(10, 2)

  pedido  Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id])

  @@index([pedidoId])
  @@map("item_pedido")
}

/// RF0037 e RN0034: a compra pode ser quitada por vários cartões e cupons.
/// Cada parcela do pagamento é uma linha desta tabela.
model Pagamento {
  id       Int            @id @default(autoincrement())
  pedidoId Int            @map("pedido_id")
  forma    FormaPagamento
  valor    Decimal        @db.Decimal(10, 2)
  cartaoId Int?           @map("cartao_id")
  cupomId  Int?           @map("cupom_id")

  pedido Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  cartao Cartao? @relation(fields: [cartaoId], references: [id])
  cupom  Cupom?  @relation(fields: [cupomId], references: [id])

  @@index([pedidoId])
  @@map("pagamento")
}

// ---------------------------------------------------------------------------
// Grupo Sistema
// ---------------------------------------------------------------------------

/// RNF0012: toda operação de escrita registra data, hora, usuário responsável
/// e os dados alterados.
model LogTransacao {
  id              Int      @id @default(autoincrement())
  dataHora        DateTime @default(now()) @map("data_hora")
  usuarioId       Int      @map("usuario_id")
  operacao        String   @db.VarChar(20)
  entidade        String   @db.VarChar(40)
  entidadeId      String?  @map("entidade_id") @db.VarChar(24)
  dadosAnteriores Json?    @map("dados_anteriores")
  dadosNovos      Json?    @map("dados_novos")

  @@index([entidade, entidadeId])
  @@index([dataHora])
  @@map("log_transacao")
}
