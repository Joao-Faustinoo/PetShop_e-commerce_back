# Conexão com o PostgreSQL.
#
# No Supabase são DUAS strings, tiradas de Project Settings > Database:
#   DATABASE_URL -> "Transaction pooler" (porta 6543), usada pelas consultas
#   DIRECT_URL   -> "Direct connection"  (porta 5432), usada pelas migrations
# O sufixo ?pgbouncer=true na primeira é obrigatório.
DATABASE_URL="postgresql://postgres.REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Assinatura do JWT — trocar por um valor longo e aleatório
JWT_SECRET="troque-este-valor"
JWT_EXPIRES_IN="1d"

# Porta da API e origem liberada no CORS (o front roda na 3000)
PORT=3333
CORS_ORIGIN="http://localhost:3000"

# Chave do Google Gemini, usada pelo assistente de recomendação (RNF0047)
GEMINI_API_KEY=""

# RN0044: prazo do bloqueio de itens no carrinho, em minutos (padrão 30).
MINUTOS_BLOQUEIO_CARRINHO=30
MINUTOS_AVISO_BLOQUEIO=5

# RN0037: operadora simulada — cartão terminado nestes dígitos é recusado.
FINAL_CARTAO_RECUSADO="0000"

# RF0013: saldo a partir do qual o produto e inativado sozinho
ESTOQUE_MINIMO_INATIVACAO=0

# RNF0047: modelo e tempo limite do assistente
GEMINI_MODELO=gemini-2.0-flash
GEMINI_TIMEOUT_MS=15000
